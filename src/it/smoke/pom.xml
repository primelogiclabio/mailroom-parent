<?xml version="1.0" encoding="UTF-8"?>
<!-- Smoke project for mailroom-parent's own CI: a tiny child that proves the parent's settings work.
     Not a module and never deployed. Run after installing the parent:
       ./mvnw -B install
       ./mvnw -B -f src/it/smoke/pom.xml verify -Dtest.jdk=8   (or 21, 25) -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>mailroom-parent-smoke</artifactId>
    <name>mailroom-parent smoke test</name>

    <properties>
        <module.name>io.primelogiclab.mailroom.smoke</module.name>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <expected.jdk>${test.jdk}</expected.jdk>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
