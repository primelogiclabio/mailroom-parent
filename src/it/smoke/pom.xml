<?xml version="1.0" encoding="UTF-8"?>
<!-- Smoke project for mailroom-parent's own CI: two tiny children that prove the parent's settings work, one per
     Java set. Not modules of the parent and never deployed. Run after installing the parent:
       ./mvnw -B install
       ./mvnw -B -f src/it/smoke/pom.xml verify -Dtest.jdk=8   (or 21, 25)
     On JDK 8 the Java 21 module's tests skip; the Java 8 module's tests run on every JDK. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>mailroom-parent-smoke</artifactId>
    <packaging>pom</packaging>
    <name>mailroom-parent smoke test</name>

    <modules>
        <module>smoke-java21</module>
        <module>smoke-java8</module>
    </modules>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <expected.jdk>${test.jdk}</expected.jdk>
                            <expected.release>${mailroom.java}</expected.release>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
